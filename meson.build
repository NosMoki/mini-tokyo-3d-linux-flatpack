# Meson build for the GNOME desktop app. Everything specific to the desktop
# port lives in gnome/; see gnome/README.md.
#
# The app hosts the web bundle, so build it first in this directory:
#   npm install && npm run build
project('mini-tokyo-3d',
  version: '4.1.0',
  license: 'MIT',
  meson_version: '>= 1.1.0',
)

subdir('gnome')
